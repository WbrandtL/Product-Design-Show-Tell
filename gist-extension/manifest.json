{
  "manifest_version": 3,
  "name": "Gist",
  "version": "0.1.0",
  "description": "Select a passage on any page and get a verified reading diagram back, drawn from the gist-backend - never a generated image.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "minimum_chrome_version": "110"
}
