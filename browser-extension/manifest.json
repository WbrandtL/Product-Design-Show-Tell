{
  "manifest_version": 3,
  "name": "TimeAware Companion",
  "version": "0.1.0",
  "description": "Reports which domain you're browsing and for how long to your local TimeAware desktop app. All data stays on your machine.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:47850/*"],
  "minimum_chrome_version": "110"
}
